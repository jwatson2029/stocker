SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
POSTGRES_URL_NON_POOLING=postgres://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require
IMAGE_ID=19494
CAMERA_ID=12084
API_KEY=your-511ga-key
# Continuous 30s clips, full camera quality (stream copy), 24/7
RECORD_SEGMENT_SECS=30
RECORD_IDLE_SECS=0
RECORD_ENCODE=0
# Only used when RECORD_ENCODE=1 (smaller files for Render Hobby)
RECORD_VIDEO_BITRATE=2500k
RECORD_MAX_WIDTH=1280
RECORD_RETENTION_HOURS=24
RECORD_PRUNE_INTERVAL_MS=3600000
CRON_SECRET=change-me-to-a-long-random-string
CRON_RECORD_SECS=45
RECORD_TZ=America/New_York
# Equal times = quiet hours off (record around the clock)
RECORD_QUIET_START=00:00
RECORD_QUIET_END=00:00

# --- School bus detector (Dockerfile.detect / podman) ---
# Discord channel → Integrations → Webhooks → New Webhook → copy URL
DISCORD_WEBHOOK_URL=
DETECT_INTERVAL_SECS=0.15
DETECT_COOLDOWN_SECS=60
DETECT_MOTION_THRESHOLD=3
# Run YOLO at least this often even if the scene looks static (far/parked buses)
DETECT_FORCE_YOLO_SECS=0.8
DETECT_CONF=0.22
# Higher imgsz = better far/edge recall; lower = more checks/sec on 1 CPU
DETECT_IMGSZ=800
# Base yellow fraction for YOLO "bus" class (truck/car use stricter gates in code)
DETECT_YELLOW_MIN=0.12
# People alerts off — school buses only
DETECT_PEOPLE=0
DETECT_PERSON_MIN_AREA=0.001
# Debug only — keep 0 for production
DETECT_WHITE_CARS=0
YOLO_MODEL=yolo26s.pt
