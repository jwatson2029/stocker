{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/cron/record.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/cron/prune.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "crons": [
    {
      "path": "/api/cron/record",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/prune",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/still",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=5, s-maxage=5" }
      ]
    },
    {
      "source": "/api/((?!still$).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
