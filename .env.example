SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
POSTGRES_URL_NON_POOLING=postgres://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require
IMAGE_ID=19494
CAMERA_ID=12084
API_KEY=your-511ga-key
# Seconds per uploaded clip for npm run record:24x7
RECORD_SEGMENT_SECS=60
# Delete Supabase recordings older than this many hours
RECORD_RETENTION_HOURS=24
# Protect /api/cron/record (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET=change-me-to-a-long-random-string
# Seconds of HLS to capture per cron run (10–120)
CRON_RECORD_SECS=45
