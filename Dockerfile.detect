FROM python:3.11-slim-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    libglib2.0-0 \
    libgl1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-detect.txt ./
# CPU-only PyTorch (no CUDA) — fits Always Free ARM VMs
# Pre-export ONNX for faster CPU inference at DETECT_IMGSZ
RUN pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
  && pip install --no-cache-dir -r requirements-detect.txt \
  && python -c "from ultralytics import YOLO; m=YOLO('yolo26s.pt'); m.export(format='onnx', imgsz=800, simplify=True)" \
  && rm -rf /root/.cache/pip

COPY scripts/detect-bus.py ./scripts/detect-bus.py

ENV PYTHONUNBUFFERED=1
CMD ["python", "-u", "scripts/detect-bus.py"]
