SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
POSTGRES_URL_NON_POOLING=postgres://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require
IMAGE_ID=19494
CAMERA_ID=12084
API_KEY=your-511ga-key
# Continuous 30s clips, full camera quality (stream copy), 24/7
RECORD_SEGMENT_SECS=30
RECORD_IDLE_SECS=0
RECORD_ENCODE=0
# Only used when RECORD_ENCODE=1 (smaller files for Render Hobby)
RECORD_VIDEO_BITRATE=2500k
RECORD_MAX_WIDTH=1280
RECORD_RETENTION_HOURS=24
RECORD_PRUNE_INTERVAL_MS=3600000
CRON_SECRET=change-me-to-a-long-random-string
CRON_RECORD_SECS=45
RECORD_TZ=America/New_York
# Equal times = quiet hours off (record around the clock)
RECORD_QUIET_START=00:00
RECORD_QUIET_END=00:00

# --- School bus detector (Dockerfile.detect / podman) ---
# Discord channel → Integrations → Webhooks → New Webhook → copy URL
DISCORD_WEBHOOK_URL=
DETECT_INTERVAL_SECS=3
DETECT_COOLDOWN_SECS=180
DETECT_MOTION_THRESHOLD=12
DETECT_BUS_CONF=0.35
DETECT_YELLOW_RATIO=0.08
# Temporary: also alert on white cars (set 0 to disable)
DETECT_WHITE_CARS=1
